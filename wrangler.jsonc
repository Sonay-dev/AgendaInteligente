{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agenda",
  // custom-worker.ts = handler do OpenNext + scheduled() para o Cron Trigger
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agenda-db",
      "database_id": "510305d6-7282-4e7f-97f1-0d80e5cde5e3",
      "migrations_dir": "drizzle"
    }
  ],
  // Um único gatilho a cada 5 min: reenvio de pendentes, renovação do events.watch
  // (e, na etapa 8, lembretes e briefings). O plano free permite até 5 cron triggers.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_URL": "https://agenda.sonaydev.com",
    "EMAIL_FROM": "nao-responda@sonaydev.com"
  },
  // E-mail de redefinição de senha (Cloudflare Email Service). No plano free só entrega para endereços
  // verificados em Email Routing → Destination addresses (o e-mail de ALLOWED_EMAILS precisa estar lá).
  "send_email": [{ "name": "EMAIL" }],
  // Etapa 10 — domínio personalizado (Custom Domain: a Cloudflare cria DNS e certificado)
  "routes": [{ "pattern": "agenda.sonaydev.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
